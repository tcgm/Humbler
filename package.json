{
  "name": "humbler",
  "private": true,
  "version": "0.1.0",
  "description": "A local Electron client for your Humble Bundle library: collect keys, reveal them, and bulk-download your files, using your real logged-in session.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.js dev --watch",
    "start": "node scripts/run.js start",
    "build": "node scripts/run.js build",
    "typecheck": "tsc -b",
    "scrub-data": "tsx scripts/scrub-data.ts"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.10.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@44.10.0": true
  }
}
