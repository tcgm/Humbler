# Where downloaded files go. Can also be changed from the app (saved to data/settings.json,
# which takes priority over this). Default: ./data/downloads
# DOWNLOAD_DIR=D:/Humble

# How many files download at once, and the polite pause after each one finishes.
DOWNLOAD_CONCURRENCY=2
DOWNLOAD_DELAY_MIN_MS=500
DOWNLOAD_DELAY_MAX_MS=1500

# Pause between library API calls during sync (orders are fetched 40 at a time).
API_DELAY_MIN_MS=700
API_DELAY_MAX_MS=1800

# Pause between key reveals when revealing several at once.
REVEAL_DELAY_MIN_MS=1200
REVEAL_DELAY_MAX_MS=2500

# Signed download URLs expire; orders older than this are re-fetched before downloading.
URL_MAX_AGE_MINUTES=20


# Humble login cookies that would vanish on restart get this lifetime (days). 0 = leave them alone.
SESSION_COOKIE_DAYS=30
